# Copié en ".env" à la racine du projet sur le serveur, à côté de
# docker-compose.prod.yml. Lu automatiquement par `docker compose`.

# Domaines (doivent déjà pointer vers l'IP du serveur dans Cloudflare)
DOMAIN=ivoiretourvillage.org
API_DOMAIN=api.ivoiretourvillage.org

# Inliné dans le bundle JS du frontend au moment du build — doit donc
# correspondre à API_DOMAIN ci-dessus.
NEXT_PUBLIC_API_URL=https://api.ivoiretourvillage.org/api

# Doivent être IDENTIQUES aux valeurs DB_DATABASE / DB_USERNAME /
# DB_PASSWORD de backend/.env, car ce sont ces variables qui
# initialisent la base PostgreSQL au tout premier démarrage.
DB_DATABASE=ivoire_tour_village
DB_USERNAME=itv
DB_PASSWORD=change-me-generate-a-strong-password
