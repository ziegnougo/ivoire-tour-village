# Copié en "backend/.env" sur le serveur (chargé par le service
# "backend" de docker-compose.prod.yml via env_file).

APP_NAME="Ivoire-Tour Village"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ivoiretourvillage.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Doivent être identiques aux valeurs DB_DATABASE / DB_USERNAME /
# DB_PASSWORD du ".env" à la racine (utilisées pour initialiser
# PostgreSQL au premier démarrage du conteneur).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ivoire_tour_village
DB_USERNAME=itv
DB_PASSWORD=change-me-generate-a-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Zoho Mail, comme prévu au cahier des charges (section Infrastructures
# technologiques). Adapter selon le compte réellement créé.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=contact@ivoiretourvillage.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@ivoiretourvillage.org"
MAIL_FROM_NAME="${APP_NAME}"

# Restreint aux domaines réels du frontend en production (pas de "*").
CORS_ALLOWED_ORIGINS=https://ivoiretourvillage.org

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
